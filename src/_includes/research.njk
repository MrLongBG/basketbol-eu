---
layout: base.njk
---
<article class="post">
  <div class="content post-content">

    <header class="post-header">
      <h1 class="post-title">{{ title }}</h1>
      <div class="post-meta">
        <span>{{ site.author }}</span>
        <span class="post-meta-sep">·</span>
        <span>{{ page.date | dateEN }}</span>
      </div>
    </header>

    <div class="post-body">
      {{ content | safe }}
    </div>

    <div class="see-more" style="margin-top: 28px;">
      <a href="/research/" class="see-more-link">← Back to research</a>
    </div>

  </div>
</article>
